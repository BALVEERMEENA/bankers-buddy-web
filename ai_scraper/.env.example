# The extractor auto-picks a backend:
#   - ANTHROPIC_API_KEY set  -> uses Claude
#   - otherwise              -> uses local Ollama (no key, no cloud)
# Force one explicitly with BANKERS_PROVIDER=ollama | anthropic

# --- Local Ollama (default) ---
# Install Ollama from https://ollama.com, then: ollama pull llama3.1
# BANKERS_PROVIDER=ollama
# BANKERS_MODEL=llama3.1
# OLLAMA_HOST=http://localhost:11434   # only if Ollama runs elsewhere

# --- Anthropic (optional) ---
# BANKERS_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# BANKERS_MODEL=claude-opus-5
